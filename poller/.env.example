# IP address of the ESP32 on the LAN
ESP32_IP=192.168.1.50

# Comma-separated calendar IDs to check for busy status.
# "primary" is the personal account's own calendar; the work calendar
# appears as a subscribed "Other calendar" with free/busy-only blocks.
CALENDAR_IDS=primary,joe.sanford@bighealth.com

# Seconds between freebusy polls
POLL_INTERVAL_SECONDS=60

# Path to the OAuth token generated by authorize.py (mounted into the container)
TOKEN_PATH=/secrets/token.json
